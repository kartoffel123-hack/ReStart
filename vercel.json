{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "headers": [
        { "source": "/models/30465/channel.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/models/30465/pilot/:file*", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/models/30465/releases/:generation/:file*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
}
