{
  "name": "restart-manual",
  "private": true,
  "version": "0.1.0",
  "description": "ReStart: AI-based disassembly analysis and repair manual for the LEGO Technic helicopter 30465 (Healthcare Hackathon 2026, Siemens Healthineers challenge).",
  "type": "module",
  "engines": {
    "node": "24.22.3",
    "npm": ">=11"
  },
  "scripts": {
    "pilot:build": "tsx tools/pilot/run.ts",
    "model:classify": "tsx tools/classification/run.ts",
    "model:propose": "tsx tools/classification/propose-run.ts",
    "dev": "vite",
    "predev": "tsx tools/pilot/ensure.ts",
    "pretest": "tsx tools/pilot/ensure.ts",
    "build": "vite build",
    "prebuild": "npm run typecheck && tsx tools/pilot/ensure.ts && tsx tools/verify/site-run.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=helicopter",
    "test:e2e:ct": "playwright test --project=ct --workers=1",
    "test:ct-data": "node --import tsx --test tests/ct/clearance.check.ts",
    "model:import": "tsx tools/model.ts import",
    "model:dof": "tsx tools/dof/run.ts",
    "model:compile": "tsx tools/model.ts compile",
    "model:verify": "tsx tools/model.ts verify",
    "model:ct-stage": "tsx tools/model.ts stage --dataset 4000041",
    "model:publish": "tsx tools/verify/promote.ts",
    "model:worklist": "tsx tools/verify/worklist.ts",
    "progress:screenshot": "tsx tools/progress/capture.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.4",
    "@gltf-transform/core": "4.5.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "6.0.2",
    "@xyflow/react": "13.0.3",
    "exceljs": "4.4.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "occt-import-js": "0.0.23",
    "three-mesh-bvh": "0.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.0.14",
    "vitest": "4.1.7",
    "zod": "4.6.7"
  }
}
